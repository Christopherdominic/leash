# --- PayPal (sandbox) -------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your app
# Leave empty (or set MOCK_PAYPAL=1) to run with a fake PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# MOCK_PAYPAL=1

# --- AI model (any ONE of these) --------------------------------------------
# Free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Optional: force a provider (google | openai | anthropic) or model name
# AI_PROVIDER=google
# AI_MODEL=gemini-3.8-flash

# --- Product catalog (optional) ---------------------------------------------
# Free key at trychannel3.com. Without it, a built-in demo catalog is used.
CHANNEL3_API_KEY=

# --- Phone push for approvals (optional) ------------------------------------
# Install the ntfy app, subscribe to a hard-to-guess topic name, put it here.
NTFY_TOPIC=

# --- Public URL (set in production so PayPal can redirect back) -------------
# APP_URL=https://leash.onrender.com
